# Purpose-built for the post-sweep max-cap re-check (CapRecheck.hh).
# One dont-touch driver, N symmetric buffer sinks on its net, one
# flop behind each. See global_sizing_cap_recheck.tcl.
VERSION 5.8 ; 
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN cap_recheck ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 40000 900000 ) ;

COMPONENTS 13 ;
- src DFF_X1 + PLACED   ( 10000 100000 ) N ;
- b0 BUF_X1 + PLACED   ( 20000 200000 ) N ;
- b1 BUF_X1 + PLACED   ( 20000 300000 ) N ;
- b2 BUF_X1 + PLACED   ( 20000 400000 ) N ;
- b3 BUF_X1 + PLACED   ( 20000 500000 ) N ;
- b4 BUF_X1 + PLACED   ( 20000 600000 ) N ;
- b5 BUF_X1 + PLACED   ( 20000 700000 ) N ;
- e0 DFF_X1 + PLACED   ( 30000 200000 ) N ;
- e1 DFF_X1 + PLACED   ( 30000 300000 ) N ;
- e2 DFF_X1 + PLACED   ( 30000 400000 ) N ;
- e3 DFF_X1 + PLACED   ( 30000 500000 ) N ;
- e4 DFF_X1 + PLACED   ( 30000 600000 ) N ;
- e5 DFF_X1 + PLACED   ( 30000 700000 ) N ;
END COMPONENTS

PINS 1 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL + FIXED ( 10000 3333 ) N + LAYER metal2 ( 0 0 ) ( 0 0 ) ;
END PINS

NETS 8 ;
- clk ( PIN clk ) ( src CK ) ( e0 CK ) ( e1 CK ) ( e2 CK ) ( e3 CK ) ( e4 CK ) ( e5 CK ) + USE SIGNAL ;
- n ( src Q ) ( b0 A ) ( b1 A ) ( b2 A ) ( b3 A ) ( b4 A ) ( b5 A ) + USE SIGNAL ;
- m0 ( b0 Z ) ( e0 D ) + USE SIGNAL ;
- m1 ( b1 Z ) ( e1 D ) + USE SIGNAL ;
- m2 ( b2 Z ) ( e2 D ) + USE SIGNAL ;
- m3 ( b3 Z ) ( e3 D ) + USE SIGNAL ;
- m4 ( b4 Z ) ( e4 D ) + USE SIGNAL ;
- m5 ( b5 Z ) ( e5 D ) + USE SIGNAL ;
END NETS
END DESIGN
